---
const { head } = Astro.locals.starlightRoute;
const titleValue = head.find(
  (entry) =>
    entry.tag === "meta" &&
    entry.attrs?.property === "og:title",
)?.attrs?.content;
const title = typeof titleValue === "string" ? titleValue : "ayame-spell";
const descriptionValue =
  head.find(
    (entry) =>
      entry.tag === "meta" &&
      entry.attrs?.name === "description",
  )?.attrs?.content ?? "";
const description =
  typeof descriptionValue === "string" ? descriptionValue : "";
const image = new URL("/ayame-spell/og-card.png", Astro.site).href;
---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="ayame-spell — low-noise spelling for English and Japanese" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content="ayame-spell — low-noise spelling for English and Japanese" />
